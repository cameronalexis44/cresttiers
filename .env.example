# --- Database (Postgres) ---
# Use Vercel Postgres, Neon, or Supabase. Must be a valid Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/bptiers"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Your deployed URL (Vercel sets VERCEL_URL automatically, but set this explicitly for auth emails)
NEXTAUTH_URL="http://localhost:3000"

# --- Email sign-in (magic link) ---
# Any SMTP provider works: Resend, Gmail (App Password), Mailtrap, SendGrid, etc.
EMAIL_SERVER="smtp://user:password@smtp.yourprovider.com:587"
EMAIL_FROM="BPTiers <no-reply@yourdomain.com>"

# --- Mod Menu access code ---
# This is the passcode required to unlock /mod. Change it from the default if you want
# a different code than the one you gave me. Never commit the real value to a public repo.
MOD_ACCESS_CODE="Clow-Justice-504"
