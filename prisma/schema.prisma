generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth required models (email magic-link sign-in) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- BPTiers data ---

model Player {
  id           String   @id @default(cuid())
  ign          String   // Bedrock in-game name
  category     String   // e.g. Crystal, Sword, Pot, UHC, SMP, NethPot, Axe
  tier         String   // e.g. HT1, LT1, HT2, LT2 ...
  region       String?
  addedBy      String?  // email of the mod who added/edited this entry
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model PlayerAvatar {
  ign        String   @id // lowercased IGN key
  displayIgn String
  dataUrl    String   // data:image/png;base64,...
  updatedBy  String?
  updatedAt  DateTime @updatedAt
}
